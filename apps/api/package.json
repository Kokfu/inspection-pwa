{
  "name": "@inspection-pwa/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json",
    "test:fire-alarm-definition": "tsx --test src/inspections/templates/fireAlarmDefinitionControls.test.ts",
    "test:historical-matrix": "tsx --test src/inspections/templates/historicalCompatibilityMatrix.test.ts src/inspections/dryWetRiserAccepted.test.ts src/inspections/templates/portableFireExtinguisherDefinition.test.ts",
    "test:v6-evidence": "tsx --test src/attachments/attachmentStorage.test.ts src/inspections/evidence/fireAlarmV6Evidence.test.ts src/inspections/templates/systemContractCompatibility.test.ts",
    "test:v6-integration": "tsx --test src/sync/fireAlarmV6Acceptance.integration.test.ts",
    "test:wet-chemical-definition": "tsx --test src/inspections/templates/wetChemicalDefinitionControls.test.ts",
    "test:label-overrides": "tsx --test src/inspections/labelOverrides.test.ts",
    "test:system-configuration": "tsx --test src/routes/managerSystemConfiguration.integration.test.ts",
    "test:evidence-policy": "tsx --test src/routes/managerEvidencePolicy.integration.test.ts",
    "test:locations": "tsx --test src/routes/managerLocations.integration.test.ts",
    "test:automatic-sprinkler-definition": "tsx --test src/inspections/templates/automaticSprinklerDefinitionControls.test.ts src/routes/masterSystemInspectionsAutomaticSprinklerV7.test.ts",
    "test:wet-chemical-sync": "tsx --test src/sync/wetChemicalFormInstanceSync.test.ts",
    "test:wet-chemical-v7-integration": "tsx --test src/sync/wetChemicalV7.integration.test.ts",
    "test:fire-alarm-v7-integration": "tsx --test src/sync/fireAlarmV7.integration.test.ts",
    "test:service-visits": "tsx --test src/jobs/serviceVisits.test.ts",
    "test:service-visits-integration": "tsx --test src/jobs/serviceVisits.integration.test.ts",
    "test:customer-creation-integration": "tsx --test src/routes/customerCreation.integration.test.ts",
    "test:final-report": "tsx --test src/reports/finalServiceReport.test.ts",
    "test:final-report-v6": "tsx --test src/reports/fireAlarmV6FinalReport.integration.test.ts",
    "test:final-report-integration": "tsx --test src/reports/finalServiceReport.integration.test.ts",
    "test:final-report-migrations": "tsx --test src/db/finalServiceReportHistory.integration.test.ts",
    "test:final-report-sprinkler": "tsx --test src/reports/finalServiceReport.sprinkler.integration.test.ts",
    "validate-fire-alarm": "tsx src/cli/validateFireAlarm.ts",
    "validate-fire-alarm-detail": "tsx src/cli/validateFireAlarmDetail.ts",
    "acceptance-fire-alarm": "node dist/cli/acceptanceFireAlarm.js",
    "validate-acceptance-fire-alarm": "node dist/cli/validateAcceptanceFireAlarm.js",
    "validate-legacy-orphan-fire-alarm-recovery": "node dist/cli/validateLegacyOrphanFireAlarmRecovery.js",
    "start": "node dist/server.js",
    "create-admin": "node dist/cli/createAdmin.js",
    "validate-photo-evidence": "node dist/cli/validatePhotoEvidence.js",
    "validate-dry-wet-riser": "node dist/cli/validateDryWetRiser.js",
    "validate-hose-reel": "node dist/cli/validateHoseReel.js",
    "validate-co2": "node dist/cli/validateCo2.js",
    "validate-server-summary-pagination": "node dist/cli/validateServerSummaryPagination.js",
    "validate-sync-http": "node dist/cli/validateSyncHttp.js"
  },
  "dependencies": {
    "@fontsource/noto-sans": "^5.3.0",
    "argon2": "^0.44.0",
    "busboy": "^1.6.0",
    "express": "^4.21.2",
    "pdfkit": "^0.17.2",
    "pg": "^8.13.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
