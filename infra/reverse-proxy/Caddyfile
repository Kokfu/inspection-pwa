{
	email off
}

{$PUBLIC_HOSTNAME:localhost} {
	log {
		output file /var/log/caddy/access.log
		format json
	}

	encode zstd gzip

	handle_path /api/* {
		reverse_proxy api:3000
	}

	# Missing hashed build assets must be a 404. Falling back to index.html gives
	# stale PWA shells HTML where JavaScript or CSS is expected, preventing React
	# from bootstrapping after a release.
	handle /assets/* {
		root * /srv/releases/current
		@existing_hashed_asset file
		header @existing_hashed_asset Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv/releases/current

		# HTML navigations, the service worker, and other unhashed shell files must
		# revalidate. The /assets handler above is the only immutable namespace.
		header Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
